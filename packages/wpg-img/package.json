{
  "name": "wpg-img",
  "version": "1.0.3",
  "description": "Official <wpg-img> Web Component & Offline WebAssembly Decoder for WPG (Web Progressive Graphic) — Next-Gen Open Image Format",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./worker": "./dist/wpg-worker.js",
    "./wasm": "./wpg-decoder.wasm"
  },
  "files": [
    "dist",
    "wpg-decoder.wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node test.js"
  },
  "keywords": [
    "wpg",
    "web-progressive-graphic",
    "image-format",
    "avif",
    "av1",
    "web-component",
    "zero-cls",
    "wasm",
    "performance"
  ],
  "author": "WPG Format Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontnetcoin-jpg/web-progressive-graphic.git"
  }
}
